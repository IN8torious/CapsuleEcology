<Page
    x:Class="CapsuleEcology.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:CapsuleEcology.Services">
    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Tweaks — The Law-Bound Core" FontFamily="Georgia" FontSize="30" Foreground="#F3EAD8"/>
        <TextBlock Grid.Row="1" x:Name="Summary" Foreground="#A49A83" FontSize="13.5" TextWrapping="Wrap" MaxWidth="820" Margin="0,4,0,10"/>
        <TextBox Grid.Row="2" x:Name="Filter" PlaceholderText="Filter options…" TextChanged="Filter_TextChanged" Margin="0,0,0,10"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="OptionList" SelectionMode="Multiple" SelectionChanged="OptionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:FullOption">
                        <StackPanel Padding="2">
                            <TextBlock Text="{x:Bind Text}" Foreground="#E8E4DA" FontSize="13.5"/>
                            <TextBlock Text="{x:Bind Id}" FontFamily="Consolas" FontSize="11" Foreground="#6F675A"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Column="2" Background="#101014" BorderBrush="#2A0D13" BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer><TextBlock x:Name="PlanOut" FontFamily="Consolas" FontSize="11.5" Foreground="#BDB4A0" TextWrapping="Wrap" Text="Select options to see the exact plan — every action, in order, before anything is touched."/></ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
            <Button x:Name="BtnApply" Content="Apply selected" Click="BtnApply_Click"/>
            <Button x:Name="BtnRevert" Content="Revert selected" Click="BtnRevert_Click"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="13" Foreground="#A49A83" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
