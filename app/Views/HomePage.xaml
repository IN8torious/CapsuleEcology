<Page
    x:Class="CapsuleEcology.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="30,24,30,40" Spacing="14" MaxWidth="1060" HorizontalAlignment="Left">
            <TextBlock Text="Your Ecosystem" FontFamily="Georgia" FontSize="30" Foreground="{ThemeResource CapsuleInkBrush}"/>
            <TextBlock Text="Welcome to your digital civilization. Everything here is yours — adopted, raised, forked, and receipted. Nothing phones home; every claim on this page can be inspected."
                       Foreground="{ThemeResource CapsuleDimBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="760"/>
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="250" ItemHeight="118">
                <Border Style="{StaticResource BezelCardStyle}" Padding="16" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="MODEL LINEAGE" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
                    <TextBlock x:Name="StatModels" Text="—" FontFamily="Georgia" FontSize="26" Foreground="{ThemeResource CapsuleInkBrush}"/>
                    <TextBlock Text="Pinned to source, hash-verified, carrying their ancestry." Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Style="{StaticResource BezelCardStyle}" Padding="16" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="ACTIVE AGENTS" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
                    <TextBlock Text="8 citizens" FontFamily="Georgia" FontSize="26" Foreground="{ThemeResource CapsuleInkBrush}"/>
                    <TextBlock Text="Mira holds the Gate. Nothing executes unapproved." Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Style="{StaticResource BezelCardStyle}" Padding="16" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="TWEAK CORE" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
                    <TextBlock x:Name="StatTweaks" Text="—" FontFamily="Georgia" FontSize="26" Foreground="{ThemeResource CapsuleInkBrush}"/>
                    <TextBlock Text="Gated, reversible actions. Security untouched — by law." Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Style="{StaticResource BezelCardStyle}" Padding="16" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="SCRIPTURE" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
                    <TextBlock Text="31,098 verses" FontFamily="Georgia" FontSize="26" Foreground="{ThemeResource CapsuleInkBrush}"/>
                    <TextBlock Text="The Toolbox Bible — on device, verified." Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </VariableSizedWrapGrid>
            <TextBlock Text="APPEARANCE — YOUR COLORS" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
            <Border Style="{StaticResource BezelCardStyle}" Padding="16">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Obsidian (dark)" Click="Appearance_Click" Tag="Obsidian"/>
                        <Button Content="Slate (cool dark)" Click="Appearance_Click" Tag="Slate"/>
                        <Button Content="Paper (light)" Click="Appearance_Click" Tag="Paper"/>
                        <TextBlock x:Name="ThemeStatus" Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Accent:" Foreground="{ThemeResource CapsuleDimBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Width="30" Height="30" Background="#D9777F" Click="Accent_Click" Tag="#D9777F"/>
                        <Button Width="30" Height="30" Background="#DFAE52" Click="Accent_Click" Tag="#DFAE52"/>
                        <Button Width="30" Height="30" Background="#6AA8D9" Click="Accent_Click" Tag="#6AA8D9"/>
                        <Button Width="30" Height="30" Background="#9A7FD9" Click="Accent_Click" Tag="#9A7FD9"/>
                        <Button Width="30" Height="30" Background="#D96F4E" Click="Accent_Click" Tag="#D96F4E"/>
                        <Button Width="30" Height="30" Background="#7FAE7A" Click="Accent_Click" Tag="#7FAE7A"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="RECENT RECEIPTS" Foreground="{ThemeResource CapsuleRoseBrush}" FontSize="12" CharacterSpacing="120"/>
            <Border Style="{StaticResource BezelCardStyle}" Padding="16">
                <StackPanel x:Name="ReceiptList" Spacing="4"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
