<Page
    x:Class="CapsuleEcology.Views.ReceiptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Capsule.Contracts">
    <ScrollViewer>
        <StackPanel Margin="30,24,30,40" Spacing="14" MaxWidth="1060" HorizontalAlignment="Left">
            <TextBlock Text="Receipts — Inspect It" FontFamily="Georgia" FontSize="30" Foreground="{ThemeResource CapsuleInkBrush}"/>
            <TextBlock Text="Not “trust Nate.” This chain is sealed by the C# port of the SI ledger — byte-compatible with the web kernel, RingFlow, and Nimbusis. The hashes below are the ground truth."
                       Foreground="{ThemeResource CapsuleDimBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="760"/>
            <ListView x:Name="EntryList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:LedgerEntry">
                        <TextBlock FontSize="13" Foreground="{ThemeResource CapsuleInkBrush}">
                            <Run Text="#"/><Run Text="{x:Bind Seq}"/><Run Text="  "/><Run Text="{x:Bind Agent}"/><Run Text="  ·  "/><Run Text="{x:Bind Kind}"/><Run Text="  ·  "/><Run Text="{x:Bind Event}"/><Run Text="   →  "/><Run Text="{x:Bind Hash}" Foreground="{ThemeResource CapsuleGoldBrush}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnVerify" Content="Verify the chain" Click="BtnVerify_Click"/>
                <Button x:Name="BtnTamper" Content="Tamper with entry 3" Click="BtnTamper_Click"/>
                <TextBlock x:Name="VerifyOut" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
