<Page
    x:Class="CapsuleEcology.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:CapsuleEcology.Services">
    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Apps — Environment Capsules" FontFamily="Georgia" FontSize="30" Foreground="{ThemeResource CapsuleInkBrush}"/>
        <TextBlock Grid.Row="1" x:Name="Summary" Foreground="{ThemeResource CapsuleDimBrush}" FontSize="13.5" TextWrapping="Wrap" MaxWidth="860" Margin="0,4,0,10"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListView x:Name="PackList" SelectionMode="Single" SelectionChanged="PackList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:Pack">
                        <StackPanel Padding="2">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource CapsuleInkBrush}" FontSize="14"/>
                            <TextBlock Text="{x:Bind AppsText}" FontSize="11.5" Foreground="{ThemeResource CapsuleDimBrush}"/>
                            <TextBlock Text="{x:Bind Role}" FontSize="11.5" Foreground="{ThemeResource CapsuleFaintBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ListView x:Name="AppsList" SelectionMode="Multiple" SelectionChanged="AppsList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:PackApp">
                            <StackPanel Padding="2">
                                <TextBlock Foreground="{ThemeResource CapsuleInkBrush}" FontSize="13.5">
                                    <Run Text="{x:Bind Name}"/><Run Text="  ·  "/><Run Text="{x:Bind OptionalText}"/>
                                </TextBlock>
                                <TextBlock Text="{x:Bind SourceText}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource CapsuleFaintBrush}"/>
                                <TextBlock Text="{x:Bind Note}" FontSize="11.5" Foreground="{ThemeResource CapsuleDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Background="{ThemeResource CapsuleBgBrush}" BorderBrush="{ThemeResource CapsuleLineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer><TextBlock x:Name="PlanOut" FontFamily="Consolas" FontSize="11.5" Foreground="{ThemeResource CapsuleDimBrush}" TextWrapping="Wrap" Text="Select a pack to see its full manifest — every app and exactly where it comes from — before anything is installed."/></ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
            <Button x:Name="BtnInstall" Content="Install selected apps" Click="BtnInstall_Click"/>
            <Button x:Name="BtnUninstall" Content="Uninstall selected apps" Click="BtnUninstall_Click"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource CapsuleDimBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
